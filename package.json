{
	"name": "affinirum",
	"version": "1.6.0",
	"description": "Affinirum Scripting Language",
	"main": "dst/cjs/index.js",
	"module": "dst/index.js",
	"types": "dst/index.d.ts",
	"type": "module",
	"homepage": "https://github.com/affinir/affinirum",
	"bugs": "https://github.com/affinir/affinirum/issues",
	"author": "Riad Baghbanli <riadb@affinir.com>",
	"contributors": [
		{
			"name": "Riad Baghbanli",
			"email": "riadb@affinir.com"
		}
	],
	"keywords": [
		"Affinirum",
		"scripting",
		"language",
		"parsing",
		"compilation",
		"evaluation",
		"void",
		"boolean",
		"timestamp",
		"float",
		"integer",
		"buffer",
		"string",
		"array",
		"object",
		"function"
	],
	"scripts": {
		"clean": "rimraf --glob dst/* && rimraf --glob *.tgz",
		"prebuild": "npm run clean",
		"build": "tsc --build tsconfig.esm.json && tsc --build tsconfig.cjs.json && copyfiles ./cjs/package.json ./dst",
		"pretest": "npm run clean && tsc --build tsconfig.test.json",
		"test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
		"lint": "eslint ./src ./spc",
		"lint-fix": "eslint ./src ./spc --fix",
		"prepare": "npm run build"
	},
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/affinir/affinirum.git"
	},
	"exports": {
		".": {
			"import": "./dst/index.js",
			"require": "./dst/cjs/index.js"
		}
	},
	"dependencies": {},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@stylistic/eslint-plugin": "~5.10.0",
		"@types/jest": "~30.0.0",
		"@types/node": "~24.19.2",
		"copyfiles": "~2.4.1",
		"eslint": "~10.11.0",
		"jest": "~30.5.2",
		"rimraf": "~6.1.3",
		"typescript": "~6.0.3",
		"typescript-eslint": "~8.70.1"
	}
}
